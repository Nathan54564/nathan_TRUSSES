// =============================================================================
// Example Simulation: Two Spirit Robots Connected by Two Trusses
// Each robot is built using SpiritFactory and is attached to the other via two trusses.
// The truss (arm) lengths are updated sinusoidally over time.
// =============================================================================

#include <cstddef>
#include <cstdlib>
#include <chrono>
#include <thread>
#include <memory>
#include <atomic>
#include <csignal>
#include <cmath>

// Chrono
#include "chrono/physics/ChSystemSMC.h"
#include "chrono/utils/ChUtilsInputOutput.h"
#include "chrono/collision/bullet/ChCollisionSystemBullet.h"
#include "chrono_irrlicht/ChVisualSystemIrrlicht.h"
#include "chrono_vehicle/terrain/SCMTerrain.h"
#include "chrono_thirdparty/filesystem/path.h"

// ROS2
#include "rclcpp/rclcpp.hpp"
#include "std_srvs/srv/trigger.hpp"
#include <std_msgs/msg/int64.hpp>

// Our custom Spirit and Truss classes (Truss now has GetConnectorBody())
#include "sim_tools/SpiritFactory.h"
#include "sim_tools/Spirit.h"
#include "sim_tools/Truss.h"
#include "sim_tools/VariableSoilParams.h"
#include "sim_tools/SimpleMovingAverage.h"
#include "sim_tools/SetpointController.h"

using namespace chrono;
using namespace chrono::irrlicht;

// Define PI
constexpr double PI = 3.14159265358979323846;

// Global flags for termination
std::atomic_bool g_terminate_requested(false);
std::atomic_bool g_advance_simulation(false);

// Handle CTRL-C
void signal_handler(int signum) {
    if (signum == SIGINT) {
        g_terminate_requested.store(true);
        RCLCPP_INFO(rclcpp::get_logger("main"), "Termination signal (CTRL-C) received. Shutting down...");
    }
}

// ROS2 service callback to advance simulation (optional)
void advance_simulation_callback(
    const std::shared_ptr<std_srvs::srv::Trigger::Request> /*request*/,
    std::shared_ptr<std_srvs::srv::Trigger::Response> response)
{
    g_advance_simulation.store(true);
    while (g_advance_simulation.load() && rclcpp::ok() && !g_terminate_requested.load()) {
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }
    response->success = true;
    response->message = "Simulation advanced";
    RCLCPP_INFO(rclcpp::get_logger("main"), "Simulation advanced");
}

// Spin the ROS2 executor in a separate thread
void run_executor(const std::shared_ptr<rclcpp::executors::SingleThreadedExecutor>& executor) {
    while (rclcpp::ok() && !g_terminate_requested.load()) {
        executor->spin_some();
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }
}

int main(int argc, char* argv[]) {
    // ---------------------------
    // ROS2 Setup
    // ---------------------------
    rclcpp::init(argc, argv);
    std::signal(SIGINT, signal_handler);
    auto node = rclcpp::Node::make_shared("chrono_spirit_dual_sim_node");
    auto service = node->create_service<std_srvs::srv::Trigger>("advance_simulation", &advance_simulation_callback);
    auto executor = std::make_shared<rclcpp::executors::SingleThreadedExecutor>();
    executor->add_node(node);
    std::thread executor_thread(run_executor, executor);

    // ---------------------------
    // Chrono System & Terrain
    // ---------------------------
    SetChronoDataPath("/usr/local/share/chrono/data/");
    ChSystemSMC sys;
    sys.SetGravitationalAcceleration(ChVector3d(0, 0, -9.81));

    auto collsys = chrono_types::make_shared<ChCollisionSystemBullet>();
    sys.SetCollisionSystem(collsys);
    sys.SetNumThreads(4, 8, 1);
    collsys->SetNumThreads(4);
    sys.SetSolverType(ChSolver::Type::BARZILAIBORWEIN);

    double step_size = 0.001;

    vehicle::SCMTerrain terrain(&sys);
    terrain.Initialize(20, 20, 0.02);
    auto terrain_material = chrono_types::make_shared<ChVisualMaterial>();
    terrain_material->SetDiffuseColor(ChColor(0.9f, 0.8f, 0.6f));
    terrain.GetMesh()->SetMaterial(0, terrain_material);
    terrain.GetMesh()->SetWireframe(false);
    terrain.SetSoilParameters(0.2e8, 0, 1.1, 0, 30, 0.01, 0.25e8, 3e4);
    terrain.EnableBulldozing(false);

    // ---------------------------
    // Create Spirit Robots
    // ---------------------------
    // Define positions for the two robots
    ChVector3d pos0(0, 0, 0.19);
    ChVector3d pos1(1, 0, 0.19);

    // Define two truss attachment positions per robot (for example, one on the right and one on the left)
    std::vector<ChVector3d> truss_positions = {
        ChVector3d(0.25, 0, 0.025),   // Attachment point for the first truss
        ChVector3d(-0.25, 0, 0.025)   // Attachment point for the second truss
    };

    SpiritFactory factory(&sys);
    auto spirit0 = factory.BuildSpirit(pos0, QUNIT, truss_positions);
    auto spirit1 = factory.BuildSpirit(pos1, Q_ROTATE_X_TO_Y, truss_positions);

    // Enable collisions with the terrain
    spirit0->AddMovingPatchesAndCollisions(terrain);
    spirit1->AddMovingPatchesAndCollisions(terrain);

    // Dock the two trusses between the two robots.
    // For the first truss, use the offset corresponding to the first attachment point.
    spirit0->DockTruss(0, spirit1->m_body, ChVector3d(0.25, 0, 0.025));
    // For the second truss, use the offset corresponding to the second attachment point.
    spirit0->DockTruss(1, spirit1->m_body, ChVector3d(-0.25, 0, 0.025));

    // Calculate the baseline length between the two robots
    double L01 = (pos1 - pos0).Length();

    // Oscillation parameters (keep amplitude small to avoid detachment)
    double amplitude = 0.05;   // 5 cm variation
    double frequency = 0.5;    // 0.5 Hz

    // ---------------------------
    // Visualization Setup
    // ---------------------------
    auto vis_irr = chrono_types::make_shared<ChVisualSystemIrrlicht>();
    vis_irr->SetWindowSize(1600, 1200);
    vis_irr->SetWindowTitle("2 Spirit Robots with Dual Trusses");
    vis_irr->SetCameraVertical(CameraVerticalDir::Z);
    vis_irr->Initialize();
    vis_irr->AddSkyBox();
    vis_irr->AddTypicalLights();
    vis_irr->AddCamera(ChVector3d(0, -2.0, 1.4), ChVector3d(0, 0, 0.5));
    vis_irr->EnableShadows();
    vis_irr->AttachSystem(&sys);

    RCLCPP_INFO(node->get_logger(), "Dual spirit simulation node started. Running...");

    // ---------------------------
    // Main Simulation Loop
    // ---------------------------
    double sim_time = sys.GetChTime();
    while (rclcpp::ok() && vis_irr->Run() && !g_terminate_requested.load()) {
        sim_time = sys.GetChTime();

        // Calculate desired lengths for each truss using sinusoidal oscillations
        double desired_length_0 = L01 + amplitude * std::sin(2.0 * PI * frequency * sim_time);
        double desired_length_1 = L01 + amplitude * std::sin(2.0 * PI * frequency * sim_time + PI/2.0);

        // Update the desired lengths for both trusses on each robot
        spirit0->m_trusses[0].SetArmDesiredLength(desired_length_0);
        spirit0->m_trusses[1].SetArmDesiredLength(desired_length_1);
        spirit1->m_trusses[0].SetArmDesiredLength(desired_length_0);
        spirit1->m_trusses[1].SetArmDesiredLength(desired_length_1);

        RCLCPP_INFO(node->get_logger(),
                    "Time=%.3f | Truss0=%.3f | Truss1=%.3f",
                    sim_time, desired_length_0, desired_length_1);

        // Render the scene
        vis_irr->BeginScene();
        vis_irr->Render();
        vis_irr->EndScene();

        // Advance the simulation
        sys.DoStepDynamics(step_size);
    }

    if (executor_thread.joinable()) {
        executor_thread.join();
    }
    rclcpp::shutdown();
    return 0;
}