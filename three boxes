// =============================================================================
// Example Simulation: Three Spirit Robots Connected by Three Arms (Triangle)
// Each arm (truss) extends and contracts sinusoidally over time
// =============================================================================

// Chrono Packages
#include "chrono/physics/ChSystemSMC.h"
#include "chrono/utils/ChUtilsInputOutput.h"
#include "chrono/collision/bullet/ChCollisionSystemBullet.h"
#include "chrono_irrlicht/ChVisualSystemIrrlicht.h"
#include "chrono_vehicle/terrain/SCMTerrain.h"
#include "chrono_thirdparty/filesystem/path.h"

// ROS Packages
#include "rclcpp/rclcpp.hpp"
#include <std_msgs/msg/int64.hpp>
#include "std_srvs/srv/trigger.hpp"

// Standard Packages
#include <cstdlib>
#include <chrono>
#include <thread>
#include <memory>
#include <atomic>
#include <csignal>
#include <cmath>

// Custom Classes
#include "sim_tools/SpiritFactory.h"
#include "sim_tools/Spirit.h"
#include "sim_tools/Truss.h"
#include "sim_tools/VariableSoilParams.h"
#include "sim_tools/SimpleMovingAverage.h"
#include "sim_tools/SetpointController.h"

using namespace chrono;
using namespace chrono::irrlicht;

// =============================================================================
// Global variable to track if termination signal (CTRL-c) was received
// =============================================================================
std::atomic_bool g_terminate_requested(false);

// Signal handler function
void signal_handler(int signum) {
  if (signum == SIGINT) {
    g_terminate_requested.store(true);
    RCLCPP_INFO(rclcpp::get_logger("main"), "Termination signal (CTRL-c) received. Shutting down...");
  }
}

// Global flag to track if the simulation should advance
std::atomic_bool g_advance_simulation(false);

// Service callback function
void advance_simulation_callback(
  const std::shared_ptr<std_srvs::srv::Trigger::Request> request,
  std::shared_ptr<std_srvs::srv::Trigger::Response> response)
{
    g_advance_simulation.store(true);
    while(g_advance_simulation.load() && rclcpp::ok() && !g_terminate_requested.load()){
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }
    response->success = true;
    response->message = "Simulation advanced";
    std::cout << "Simulation advanced" << std::endl;
}

// Function to run the single-threaded executor
void run_executor(std::shared_ptr<rclcpp::executors::SingleThreadedExecutor> executor) {
    while (rclcpp::ok() && !g_terminate_requested.load()) {
        executor->spin_some();  // Use spin_some to avoid blocking
        std::this_thread::sleep_for(std::chrono::milliseconds(100));  // Adjust as needed
    }
}

// For tracking position/orientation changes (optional)
ChVector3d previous_spirit0_position;
ChVector3d previous_spirit1_position;
ChVector3d previous_spirit2_position;
ChQuaternion<> previous_spirit0_orientation;
ChQuaternion<> previous_spirit1_orientation;
ChQuaternion<> previous_spirit2_orientation;
float position_epsilon = 0.0009;
float orientation_epsilon = 0.0015;

int main(int argc, char* argv[]) {
    // ---------------------------
    // ROS2 Initialization
    // ---------------------------
    rclcpp::init(argc,argv);
    std::signal(SIGINT, signal_handler);

    // Create the ROS node
    auto node = rclcpp::Node::make_shared("chrono_simulation_node");
    // Create the service
    auto service = node->create_service<std_srvs::srv::Trigger>(
        "advance_simulation", &advance_simulation_callback
    );

    // Create a single-threaded executor
    auto executor = std::make_shared<rclcpp::executors::SingleThreadedExecutor>();
    executor->add_node(node);
    // Launch the executor in its own thread
    std::thread executor_thread(run_executor, executor);

    // ---------------------------
    // Chrono System Setup
    // ---------------------------
    SetChronoDataPath("/usr/local/share/chrono/data/");
    ChSystemSMC sys;
    sys.SetGravitationalAcceleration(ChVector3d(0, 0, -9.81));

    auto collsys = chrono_types::make_shared<ChCollisionSystemBullet>();
    sys.SetCollisionSystem(collsys);
    sys.SetNumThreads(4, 8, 1);
    collsys->SetNumThreads(4);
    // For example, using Barzilai-Borwein solver:
    sys.SetSolverType(ChSolver::Type::BARZILAIBORWEIN);

    double step_size = 0.0025; // Timestep

    // ---------------------------
    // Terrain Setup
    // ---------------------------
    vehicle::SCMTerrain mterrain(&sys);
    double width = 5;
    double length = 5;
    double mesh_resolution = 0.02;
    mterrain.Initialize(length, width, mesh_resolution);
    mterrain.SetSoilParameters(0.2e8, 0, 1.1, 0, 30, 0.01, 0.25e8, 3e4);
    mterrain.EnableBulldozing(false);

    // ---------------------------
    // Spirit Robot Positions
    // ---------------------------
    ChVector3d spirit0_position(0, 0, 0.19);
    ChVector3d spirit1_position(1, 0.25, 0.19);
    ChVector3d spirit2_position(0, 2, 0.19);

    // For example, define a single truss position for each robot
    std::vector<ChVector3d> spirit0_truss_positions = {
        ChVector3d(0.25, 0, 0.025)
    };

    // ---------------------------
    // Create Spirit Robots
    // ---------------------------
    SpiritFactory Spiritfactory(&sys);
    auto spirit0 = Spiritfactory.BuildSpirit(spirit0_position, QUNIT,           spirit0_truss_positions);
    auto spirit1 = Spiritfactory.BuildSpirit(spirit1_position, Q_ROTATE_X_TO_Y, spirit0_truss_positions);
    auto spirit2 = Spiritfactory.BuildSpirit(spirit2_position, Q_FLIP_AROUND_Z, spirit0_truss_positions);

    // Enable collisions / moving terrain patches
    spirit0->AddMovingPatchesAndCollisions(mterrain);
    spirit1->AddMovingPatchesAndCollisions(mterrain);
    spirit2->AddMovingPatchesAndCollisions(mterrain);

    // Dock the robots together (forming a triangle)
    spirit0->DockTruss(0, spirit1->m_body, ChVector3d(-0.25, 0, 0.025));
    spirit1->DockTruss(0, spirit2->m_body, ChVector3d(-0.25, 0, 0.025));
    spirit2->DockTruss(0, spirit0->m_body, ChVector3d(-0.25, 0, 0.025));

    // ---------------------------
    // Prepare CSV logging (optional)
    // ---------------------------
    const std::string out_dir = std::string(getenv("HOME")) + "/ros2_ws/src/chrono_sim";
    if (!filesystem::create_directory(filesystem::path(out_dir))) {
        std::cout << "Error creating directory " << out_dir << std::endl;
        return 1;
    }
    utils::ChWriterCSV csv(" ");

    // ---------------------------
    // Visualization Setup
    // ---------------------------
    auto vis_irr = chrono_types::make_shared<ChVisualSystemIrrlicht>();
    vis_irr->SetWindowSize(1600, 1200);
    vis_irr->SetWindowTitle("Load Spirit Example (Sinusoidal Truss Extension)");
    vis_irr->SetCameraVertical(CameraVerticalDir::Z);
    vis_irr->Initialize();
    vis_irr->AddSkyBox();
    vis_irr->AddTypicalLights();
    vis_irr->AddCamera(ChVector3d(0, -2.0, 1.4), ChVector3d(0, 0, 0.5));
    vis_irr->EnableShadows();
    vis_irr->AttachSystem(&sys);

    RCLCPP_INFO(node->get_logger(), "Chrono simulation node started. Waiting for service calls to advance simulation.");

    // Track initial positions/orientations (optional)
    previous_spirit0_position = spirit0->m_body->GetPos();
    previous_spirit0_orientation = spirit0->m_body->GetRot();
    previous_spirit1_position = spirit1->m_body->GetPos();
    previous_spirit1_orientation = spirit1->m_body->GetRot();
    previous_spirit2_position = spirit2->m_body->GetPos();
    previous_spirit2_orientation = spirit2->m_body->GetRot();

    // For optional PID / joint controllers
    SetpointController shoulderController(0.0, -0.4, -0.4, 0.0);
    SetpointController kneeController(0.0, -1.0, -1.0, 0.0);

    // ---------------------------
    // Compute baseline distances for each truss
    // ---------------------------
    double baseline_01 = (spirit1_position - spirit0_position).Length();
    double baseline_12 = (spirit2_position - spirit1_position).Length();
    double baseline_20 = (spirit0_position - spirit2_position).Length();

    // Sinusoidal parameters for the arms
    double amplitude = 0.2;  // adjust amplitude as needed
    double frequency = 0.5;  // adjust frequency as needed

    double sim_time = sys.GetChTime();

    // ---------------------------
    // Calibration / Setup Phase
    // ---------------------------
    // Fix the bodies for an initial calibration, for example
    spirit0->m_body->SetFixed(true);
    spirit1->m_body->SetFixed(true);
    spirit2->m_body->SetFixed(true);

    while(rclcpp::ok() && vis_irr->Run() && sim_time < 1.5) {
        sim_time = sys.GetChTime();
        std::cout << "Time (calibration phase): " << sim_time << std::endl;

        vis_irr->BeginScene();
        vis_irr->Render();
        vis_irr->EndScene();

        // Optionally update shoulder/knee controllers
        shoulderController.adjustSetpointWithVelocity(step_size);
        kneeController.adjustSetpointWithVelocity(step_size);

        // Example: set all shoulders/knees to 0
        spirit0->SetShoulderDesiredPosition(0, shoulderController.getSetpoint());
        spirit0->SetShoulderDesiredPosition(1, shoulderController.getSetpoint());
        spirit0->SetShoulderDesiredPosition(2, shoulderController.getSetpoint());
        spirit0->SetShoulderDesiredPosition(3, shoulderController.getSetpoint());
        spirit0->SetKneeDesiredPosition(0, kneeController.getSetpoint());
        spirit0->SetKneeDesiredPosition(1, kneeController.getSetpoint());
        spirit0->SetKneeDesiredPosition(2, kneeController.getSetpoint());
        spirit0->SetKneeDesiredPosition(3, kneeController.getSetpoint());

        // Similar for spirit1, spirit2, if desired
        // ...
        // ...
        sys.DoStepDynamics(step_size);

        if (g_terminate_requested.load()) {
            break;
        }
    }
    // Release them
    spirit0->m_body->SetFixed(false);
    spirit1->m_body->SetFixed(false);
    spirit2->m_body->SetFixed(false);

    // ---------------------------
    // Main Simulation Loop
    // ---------------------------
    int loop_index = 0;
    SimpleMovingAverage position_sma(10);
    SimpleMovingAverage orientation_sma(10);

    while (rclcpp::ok() && vis_irr->Run()) {
        spirit0->HandleROS();
        spirit1->HandleROS();
        spirit2->HandleROS();

        sim_time = sys.GetChTime();
        std::cout << "Time: " << sim_time << std::endl;

        // -----------------------------------
        // Sinusoidal update for the truss lengths
        // -----------------------------------
        double length_01 = baseline_01 + amplitude * std::sin(2.0 * CH_C_PI * frequency * sim_time + 0.0);
        double length_12 = baseline_12 + amplitude * std::sin(2.0 * CH_C_PI * frequency * sim_time + CH_C_PI / 3.0);
        double length_20 = baseline_20 + amplitude * std::sin(2.0 * CH_C_PI * frequency * sim_time + 2.0 * CH_C_PI / 3.0);

        // Update each robot's truss (index 0) to the new desired length
        spirit0->m_trusses[0].SetArmDesiredLength(length_01);  // connects spirit0 to spirit1
        spirit1->m_trusses[0].SetArmDesiredLength(length_12);  // connects spirit1 to spirit2
        spirit2->m_trusses[0].SetArmDesiredLength(length_20);  // connects spirit2 to spirit0

        vis_irr->BeginScene();
        vis_irr->Render();
        vis_irr->EndScene();

        // For optional shoulder/knee control
        // ...
        // ...

        if(g_advance_simulation.load()) {
            // Track position/orientation changes
            double position_diff = (previous_spirit0_position - spirit0->m_body->GetPos()).Length()
                                 + (previous_spirit1_position - spirit1->m_body->GetPos()).Length()
                                 + (previous_spirit2_position - spirit2->m_body->GetPos()).Length();
            position_sma.add(position_diff);

            double orientation_diff = (previous_spirit0_orientation - spirit0->m_body->GetRot()).Length()
                                    + (previous_spirit1_orientation - spirit1->m_body->GetRot()).Length()
                                    + (previous_spirit2_orientation - spirit2->m_body->GetRot()).Length();
            orientation_sma.add(orientation_diff);

            std::cout << "Pos avg: " << position_sma.getAverage()
                      << " | Orient avg: " << orientation_sma.getAverage() << std::endl;

            loop_index++;
            previous_spirit0_position = spirit0->m_body->GetPos();
            previous_spirit0_orientation = spirit0->m_body->GetRot();
            previous_spirit1_position = spirit1->m_body->GetPos();
            previous_spirit1_orientation = spirit1->m_body->GetRot();
            previous_spirit2_position = spirit2->m_body->GetPos();
            previous_spirit2_orientation = spirit2->m_body->GetRot();

            sys.DoStepDynamics(step_size);

            // Example CSV logging
            csv << sim_time
                << spirit0->m_body->GetPos() << spirit0->m_body->GetRot()
                << spirit1->m_body->GetPos() << spirit1->m_body->GetRot()
                << spirit2->m_body->GetPos() << spirit2->m_body->GetRot()
                << spirit0->m_trusses[0].GetLength() << spirit0->m_trusses[0].desired_length
                << spirit0->m_trusses[0].motor->GetMotorForce()
                << spirit1->m_trusses[0].GetLength() << spirit1->m_trusses[0].desired_length
                << spirit1->m_trusses[0].motor->GetMotorForce()
                << spirit2->m_trusses[0].GetLength() << spirit2->m_trusses[0].desired_length
                << spirit2->m_trusses[0].motor->GetMotorForce()
                << std::endl;

            // Example condition to stop advancing if position/orientation changes are small
            if(loop_index > 10
               && position_sma.getAverage() < 0.0009
               && orientation_sma.getAverage() < 0.0015) {
                loop_index = 0;
                g_advance_simulation.store(false);  // Reset the flag
            }
        }
        else {
            // If not advancing, just do a normal step
            sys.DoStepDynamics(step_size);
        }

        // Handle CTRL-C quitting
        if (g_terminate_requested.load()) {
            break;
        }
    }

    // Ensure the executor thread is joined before shutting down
    if (executor_thread.joinable()) {
        executor_thread.join();
    }

    // Write out CSV logs
    csv.WriteToFile(out_dir + "/3spirit_3truss_planner.dat");

    // Cleanly shut down ROS
    rclcpp::shutdown();
    return 0;
}