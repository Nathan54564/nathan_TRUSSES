// =============================================================================
// Example Simulation: Three Spirit Robots Connected in a Triangle
// Each robot is built using SpiritFactory and is attached to the next via a truss.
// The truss (arm) lengths are updated sinusoidally over time. We fix the error by
// adding a public GetConnectorBody() method in the Truss class, then using it here.
// Now we also write the output to a CSV file in the Downloads folder, with columns
// for time and each robot's x, y, z positions. The parentheses on std::endl() are removed.
// =============================================================================

#include <cstddef>
#include <cstdlib>
#include <chrono>
#include <thread>
#include <memory>
#include <atomic>
#include <csignal>
#include <cmath>
#include <string>

// Chrono Packages
#include "chrono/physics/ChSystemSMC.h"
#include "chrono/utils/ChUtilsInputOutput.h"  // For ChWriterCSV
#include "chrono/collision/bullet/ChCollisionSystemBullet.h"
#include "chrono_irrlicht/ChVisualSystemIrrlicht.h"
#include "chrono_vehicle/terrain/SCMTerrain.h"
#include "chrono_thirdparty/filesystem/path.h"

// ROS2 Packages
#include "rclcpp/rclcpp.hpp"
#include "std_srvs/srv/trigger.hpp"
#include <std_msgs/msg/int64.hpp>

// Our custom Spirit and Truss classes
#include "sim_tools/SpiritFactory.h"
#include "sim_tools/Spirit.h"
#include "sim_tools/Truss.h"  // now has GetConnectorBody()
#include "sim_tools/VariableSoilParams.h"
#include "sim_tools/SimpleMovingAverage.h"
#include "sim_tools/SetpointController.h"

using namespace chrono;
using namespace chrono::irrlicht;

// Define PI locally
constexpr double PI = 3.14159265358979323846;

// Global flags for termination and simulation advancement
std::atomic_bool g_terminate_requested(false);
std::atomic_bool g_advance_simulation(false);

// Handle CTRL-C
void signal_handler(int signum) {
    if (signum == SIGINT) {
        g_terminate_requested.store(true);
        RCLCPP_INFO(rclcpp::get_logger("main"),
                    "Termination signal (CTRL-C) received. Shutting down...");
    }
}

// ROS2 service callback
void advance_simulation_callback(
    const std::shared_ptr<std_srvs::srv::Trigger::Request> /*request*/,
    std::shared_ptr<std_srvs::srv::Trigger::Response> response)
{
    g_advance_simulation.store(true);
    while (g_advance_simulation.load() && rclcpp::ok() && !g_terminate_requested.load()) {
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }
    response->success = true;
    response->message = "Simulation advanced";
    RCLCPP_INFO(rclcpp::get_logger("main"), "Simulation advanced");
}

// Function to run the ROS2 executor in a separate thread
void run_executor(const std::shared_ptr<rclcpp::executors::SingleThreadedExecutor>& executor) {
    while (rclcpp::ok() && !g_terminate_requested.load()) {
        executor->spin_some();
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
    }
}

int main(int argc, char* argv[]) {
    // ---------------------------
    // ROS2 Setup
    // ---------------------------
    rclcpp::init(argc, argv);
    std::signal(SIGINT, signal_handler);
    auto node = rclcpp::Node::make_shared("chrono_spirit_triangle_sim_node");
    auto service = node->create_service<std_srvs::srv::Trigger>("advance_simulation", &advance_simulation_callback);
    auto executor = std::make_shared<rclcpp::executors::SingleThreadedExecutor>();
    executor->add_node(node);
    std::thread executor_thread(run_executor, executor);

    // ---------------------------
    // Chrono System & Terrain Setup
    // ---------------------------
    SetChronoDataPath("/usr/local/share/chrono/data/");
    ChSystemSMC sys;
    sys.SetGravitationalAcceleration(ChVector3d(0, 0, -9.81));

    auto collsys = chrono_types::make_shared<ChCollisionSystemBullet>();
    sys.SetCollisionSystem(collsys);
    sys.SetNumThreads(4, 8, 1);
    collsys->SetNumThreads(4);
    sys.SetSolverType(ChSolver::Type::BARZILAIBORWEIN);

    constexpr double step_size = 0.001;

    vehicle::SCMTerrain terrain(&sys);
    terrain.Initialize(20, 20, 0.02);
    auto terrain_material = chrono_types::make_shared<ChVisualMaterial>();
    terrain_material->SetDiffuseColor(ChColor(0.9f, 0.8f, 0.6f));
    terrain.GetMesh()->SetMaterial(0, terrain_material);
    terrain.GetMesh()->SetWireframe(false);
    terrain.SetSoilParameters(0.2e8, 0, 1.1, 0, 30, 0.01, 0.25e8, 3e4);
    terrain.EnableBulldozing(false);

    // ---------------------------
    // Create Spirit Robots
    // ---------------------------
    ChVector3d pos0(0, 0, 0.19);
    ChVector3d pos1(1, 0.25, 0.19);
    ChVector3d pos2(0, 2, 0.19);

    // Single truss position per robot
    std::vector<ChVector3d> truss_positions = { ChVector3d(0, 0, 0) };

    SpiritFactory factory(&sys);
    auto spirit0 = factory.BuildSpirit(pos0, QUNIT, truss_positions);
    auto spirit1 = factory.BuildSpirit(pos1, Q_ROTATE_X_TO_Y, truss_positions);
    auto spirit2 = factory.BuildSpirit(pos2, Q_FLIP_AROUND_Z, truss_positions);

    spirit0->AddMovingPatchesAndCollisions(terrain);
    spirit1->AddMovingPatchesAndCollisions(terrain);
    spirit2->AddMovingPatchesAndCollisions(terrain);

    // Dock the trusses rigidly (no free rotation)
    spirit0->DockTruss(0, spirit1->m_body, ChVector3d(0, 0, 0));
    spirit1->DockTruss(0, spirit2->m_body, ChVector3d(0, 0, 0));
    spirit2->DockTruss(0, spirit0->m_body, ChVector3d(0, 0, 0));

    double L01 = (pos1 - pos0).Length();
    double L12 = (pos2 - pos1).Length();
    double L20 = (pos0 - pos2).Length();

    double amplitude = 0.05;   // 5 cm variation
    double frequency = 0.5;    // 0.5 Hz

    // ---------------------------
    // CSV Logging Setup
    // ---------------------------
    // Create a CSV writer using comma as delimiter.
    utils::ChWriterCSV csv(",");
    // Write header row
    csv << "Time" << "Spirit0_x" << "Spirit0_y" << "Spirit0_z"
        << "Spirit1_x" << "Spirit1_y" << "Spirit1_z"
        << "Spirit2_x" << "Spirit2_y" << "Spirit2_z" << std::endl;

    // ---------------------------
    // Visualization Setup
    // ---------------------------
    auto vis_irr = chrono_types::make_shared<ChVisualSystemIrrlicht>();
    vis_irr->SetWindowSize(1600, 1200);
    vis_irr->SetWindowTitle("3 Spirit Robots in Triangle");
    vis_irr->SetCameraVertical(CameraVerticalDir::Z);
    vis_irr->Initialize();
    vis_irr->AddSkyBox();
    vis_irr->AddTypicalLights();
    vis_irr->AddCamera(ChVector3d(0, -2.0, 1.4), ChVector3d(0, 0, 0.5));
    vis_irr->EnableShadows();
    vis_irr->AttachSystem(&sys);

    RCLCPP_INFO(node->get_logger(), "Triangle simulation node started. Running...");

    // ---------------------------
    // Main Simulation Loop: Log Robot Positions to CSV
    // ---------------------------
    double sim_time = sys.GetChTime();
    while (rclcpp::ok() && vis_irr->Run() && !g_terminate_requested.load()) {
        sim_time = sys.GetChTime();

        // Calculate sinusoidal desired truss lengths
        double desired_length_01 = L01 + amplitude * std::sin(2.0 * PI * frequency * sim_time);
        double desired_length_12 = L12 + amplitude * std::sin(2.0 * PI * frequency * sim_time + PI/3.0);
        double desired_length_20 = L20 + amplitude * std::sin(2.0 * PI * frequency * sim_time + 2.0*PI/3.0);

        spirit0->m_trusses[0].SetArmDesiredLength(desired_length_01);
        spirit1->m_trusses[0].SetArmDesiredLength(desired_length_12);
        spirit2->m_trusses[0].SetArmDesiredLength(desired_length_20);

        // Get positions of each robot
        ChVector3d pos_spirit0 = spirit0->m_body->GetPos();
        ChVector3d pos_spirit1 = spirit1->m_body->GetPos();
        ChVector3d pos_spirit2 = spirit2->m_body->GetPos();

        // Write a CSV row: time, then x, y, z for each robot
        csv << sim_time
            << pos_spirit0.x() << pos_spirit0.y() << pos_spirit0.z()
            << pos_spirit1.x() << pos_spirit1.y() << pos_spirit1.z()
            << pos_spirit2.x() << pos_spirit2.y() << pos_spirit2.z()
            << std::endl;  // <-- remove parentheses

        vis_irr->BeginScene();
        vis_irr->Render();
        vis_irr->EndScene();

        sys.DoStepDynamics(step_size);
    }

    // Write the CSV file to the Downloads folder
    std::string downloads_path = std::string(getenv("HOME")) + "/Downloads/spirit_positions.csv";
    csv.WriteToFile(downloads_path);

    if (executor_thread.joinable()) {
        executor_thread.join();
    }
    rclcpp::shutdown();
    return 0;
}